(library
 (name tree_sitter_nix)
 (public_name tree_sitter_nix)
 (wrapped false)
 (foreign_stubs
  (language c)
  (names tree_sitter_nix_stubs parser scanner)
  (flags
   -std=c11
   -I../../src
   -I../../src/tree_sitter
   -fPIC)
  (include_dirs ../../src ../../src/tree_sitter))
 (c_library_flags -lm))

;; The grammar's generated parser and external scanner live in src/ at the
;; repo root. dune's foreign_stubs expects sources alongside this dune file,
;; so we symlink them via copy_files directives below. `-I../../src` above
;; covers the tree_sitter/parser.h include path the sources need.

(copy_files#
 (files ../../src/parser.c))

(copy_files#
 (files ../../src/scanner.c))
